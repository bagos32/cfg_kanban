  "assessment_reference",
  "certification_reference",
  "external_evidence_id",
  "external_revision_snapshot",
  "approval_section",
  "status",
  "approved_by",
  "approved_on",
  "status_reason",
  "status_changed_by",
  "status_changed_on",
  "revoked_by",
  "revoked_on",
  "notes"
 ],
 "fields": [
  {"fieldname":"employee_section","label":"Employee and Skill","fieldtype":"Section Break"},
  {"fieldname":"employee","label":"Employee","fieldtype":"Link","options":"Employee","reqd":1,"in_list_view":1,"in_standard_filter":1},
  {"fieldname":"employee_name","label":"Employee Name","fieldtype":"Data","read_only":1,"in_list_view":1,"in_standard_filter":1},
  {"fieldname":"operator_profile","label":"Operator Profile","fieldtype":"Link","options":"CFG Kanban Operator Profile","read_only":1,"in_standard_filter":1,"description":"Resolved from the selected Employee. Competency never replaces operator QR authentication or action permissions."},
  {"fieldname":"skill","label":"Skill","fieldtype":"Link","options":"CFG Kanban Skill","reqd":1,"in_list_view":1,"in_standard_filter":1},
  {"fieldname":"skill_name","label":"Skill Name","fieldtype":"Data","read_only":1,"in_list_view":1},
  {"fieldname":"competency_level","label":"Competency Level","fieldtype":"Select","options":"L0 - Untrained / Awareness Only\nL1 - Trainee\nL2 - Qualified Operator\nL3 - Senior / Lead\nL4 - Trainer / Supervisor","reqd":1,"in_list_view":1,"in_standard_filter":1},
  {"fieldname":"authorization_section","label":"Authorization Scope","fieldtype":"Section Break"},
  {"fieldname":"can_work_independently","label":"Authorized to Work Independently","fieldtype":"Check","default":"0","in_list_view":1,"description":"Requires at least L2. Later crew authorization checks this explicit approval rather than inferring permission from level alone."},
  {"fieldname":"can_supervise_trainees","label":"Authorized to Supervise Trainees","fieldtype":"Check","default":"0","in_list_view":1,"description":"Requires at least L3 and is skill-specific."},
  {"fieldname":"effective_from","label":"Effective From","fieldtype":"Date","reqd":1,"in_list_view":1,"in_standard_filter":1},
  {"fieldname":"valid_until","label":"Valid Until","fieldtype":"Date","in_list_view":1,"in_standard_filter":1,"description":"Required when the Skill uses expiry tracking. Expiry is evaluated from this date even if the stored approval status remains Active."},
  {"fieldname":"evidence_section","label":"Assessment and Evidence","fieldtype":"Section Break"},
  {"fieldname":"assessment_reference","label":"Assessment Reference","fieldtype":"Data","description":"Internal assessment, training, or authorization reference."},
  {"fieldname":"certification_reference","label":"Certification Reference","fieldtype":"Data","description":"Required only when the Skill requires certification."},
  {"fieldname":"external_evidence_id","label":"External Evidence ID","fieldtype":"Data","description":"Optional neutral reference to controlled evidence in another system. It is not a Link to TrackQMS."},
  {"fieldname":"external_revision_snapshot","label":"External Revision Snapshot","fieldtype":"Data","description":"Immutable revision identifier copied at approval time when external evidence is used."},
  {"fieldname":"approval_section","label":"Approval and Status Audit","fieldtype":"Section Break"},
  {"fieldname":"status","label":"Authorization Status","fieldtype":"Select","options":"Draft\nActive\nSuspended\nRevoked","default":"Draft","reqd":1,"read_only":1,"allow_on_submit":1,"in_list_view":1,"in_standard_filter":1},
  {"fieldname":"approved_by","label":"Approved By","fieldtype":"Link","options":"User","read_only":1,"in_standard_filter":1},
  {"fieldname":"approved_on","label":"Approved On","fieldtype":"Datetime","read_only":1},
  {"fieldname":"status_reason","label":"Status Change / Revocation Reason","fieldtype":"Small Text","allow_on_submit":1,"description":"Required before suspending, revoking, reactivating, or cancelling a submitted competency."},
  {"fieldname":"status_changed_by","label":"Status Changed By","fieldtype":"Link","options":"User","read_only":1,"allow_on_submit":1},
  {"fieldname":"status_changed_on","label":"Status Changed On","fieldtype":"Datetime","read_only":1,"allow_on_submit":1},
  {"fieldname":"revoked_by","label":"Revoked By","fieldtype":"Link","options":"User","read_only":1,"allow_on_submit":1},
  {"fieldname":"revoked_on","label":"Revoked On","fieldtype":"Datetime","read_only":1,"allow_on_submit":1},
  {"fieldname":"notes","label":"Notes","fieldtype":"Text"}
 ],
 "permissions": [
  {"role":"Manufacturing User","read":1},
  {"role":"Manufacturing Manager","read":1,"write":1,"create":1,"submit":1,"cancel":1,"amend":1,"print":1,"report":1},
  {"role":"System Manager","read":1,"write":1,"create":1,"submit":1,"cancel":1,"amend":1,"print":1,"report":1}
 ]
