{
 "doctype":"DocType","name":"CFG Kanban Operation Profile","module":"CFG Kanban","istable":1,
 "field_order":["operation","sequence","workstation","time_in_mins","mandatory","allow_parallel","dependency_operation","start_rule","minimum_qty","minimum_percentage","output_reporting_mode","allow_incremental_output","handoff_mode","transfer_multiple","require_destination_scan","destination_operation","completion_rule"],
 "fields":[
