  {"fieldname":"sequence","label":"Sequence","fieldtype":"Int","reqd":1,"in_list_view":1,"columns":1},
  {"fieldname":"workstation","label":"Workstation","fieldtype":"Link","options":"Workstation","in_list_view":1,"columns":2},
  {"fieldname":"time_in_mins","label":"Reference Operation Time (Minutes)","fieldtype":"Float","description":"Operational reference only; ERPNext scheduling time remains controlled by the BOM."},
  {"fieldname":"mandatory","label":"Mandatory","fieldtype":"Check","default":"1"},
  {"fieldname":"allow_parallel","label":"Allow Parallel","fieldtype":"Check","in_list_view":1,"columns":1},
  {"fieldname":"dependency_operation","label":"Dependency Operation","fieldtype":"Link","options":"Operation","depends_on":"eval:doc.start_rule!='No Dependency'"},
  {"fieldname":"start_rule","label":"Start Rule","fieldtype":"Select","options":"Previous Operation Complete\nMinimum Qty Available\nMinimum Percentage Available\nFull Batch Available\nNo Dependency","default":"Previous Operation Complete","in_list_view":1,"columns":2},
  {"fieldname":"minimum_qty","label":"Minimum Qty","fieldtype":"Float","depends_on":"eval:doc.start_rule=='Minimum Qty Available'","mandatory_depends_on":"eval:doc.start_rule=='Minimum Qty Available'"},
  {"fieldname":"minimum_percentage","label":"Minimum Percentage","fieldtype":"Percent","depends_on":"eval:doc.start_rule=='Minimum Percentage Available'","mandatory_depends_on":"eval:doc.start_rule=='Minimum Percentage Available'"},
  {"fieldname":"output_reporting_mode","label":"Output Reporting Mode","fieldtype":"Select","options":"Completion Only\nIncremental","default":"Completion Only"},
  {"fieldname":"allow_incremental_output","label":"Allow Incremental Output","fieldtype":"Check","depends_on":"eval:doc.output_reporting_mode=='Incremental'"},
  {"fieldname":"handoff_mode","label":"Handoff Mode","fieldtype":"Select","options":"Physical Card Handoff\nDigital Quantity Handoff\nFull Batch Handoff\nAutomatic Handoff","default":"Full Batch Handoff","in_list_view":1,"columns":3},
  {"fieldname":"transfer_multiple","label":"Transfer Multiple","fieldtype":"Float","depends_on":"eval:doc.handoff_mode=='Digital Quantity Handoff'"},
  {"fieldname":"require_destination_scan","label":"Require Destination Scan","fieldtype":"Check","depends_on":"eval:doc.handoff_mode=='Physical Card Handoff'"},
  {"fieldname":"destination_operation","label":"Destination Operation","fieldtype":"Link","options":"Operation"},
  {"fieldname":"completion_rule","label":"Completion Rule","fieldtype":"Select","options":"Full Qty\nOperator Complete\nThreshold","default":"Full Qty"}
 ]
