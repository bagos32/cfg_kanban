{
 "doctype": "DocType",
 "name": "CFG Kanban Settings",
 "module": "CFG Kanban",
 "issingle": 1,
 "track_changes": 1,
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1
  }
 ],
 "field_order": [
  "enabled",
  "default_company",
  "default_wip_warehouse",
  "default_fg_warehouse",
  "default_automation_level",
  "allow_manual_wo_for_kanban_item",
  "require_manual_override_reason",
  "auto_submit_work_order",
  "auto_start_job_card",
  "auto_submit_job_card",
  "enable_wip_ledger",
  "enable_dynamic_forms",
  "operator_session_timeout_minutes",
  "enable_administrator_operator_bypass",
  "command_retry_limit",
  "exception_email_role"
 ],
 "fields": [
  {
   "fieldname": "enabled",
   "label": "Enabled",
   "fieldtype": "Check",
   "default": "1"
  },
  {
   "fieldname": "default_company",
   "label": "Default Company",
   "fieldtype": "Link",
   "options": "Company"
  },
  {
   "fieldname": "default_wip_warehouse",
   "label": "Default WIP Warehouse",
   "fieldtype": "Link",
   "options": "Warehouse"
  },
  {
   "fieldname": "default_fg_warehouse",
   "label": "Default FG Warehouse",
   "fieldtype": "Link",
   "options": "Warehouse"
  },
  {
   "fieldname": "default_automation_level",
   "label": "Default Automation Level",
   "fieldtype": "Select",
   "options": "Automatic\nApproval\nSignal Only",
   "default": "Approval"
  },
  {
   "fieldname": "allow_manual_wo_for_kanban_item",
   "label": "Allow Manual WO for Kanban Item",
   "fieldtype": "Check"
  },
  {
   "fieldname": "require_manual_override_reason",
   "label": "Require Manual Override Reason",
   "fieldtype": "Check",
   "default": "1"
  },
  {
   "fieldname": "auto_submit_work_order",
   "label": "Auto-submit Work Order",
   "fieldtype": "Check"
  },
  {
   "fieldname": "auto_start_job_card",
   "label": "Auto-start Job Card",
   "fieldtype": "Check",
   "description": "Start the selected ERPNext Job Card when Kanban production begins."
  },
  {
   "fieldname": "auto_submit_job_card",
   "label": "Auto-submit Job Card at Target",
   "fieldtype": "Check",
   "description": "Submit the ERPNext Job Card only after its verified completed quantity reaches the full Job Card target."
  },
  {
   "fieldname": "enable_wip_ledger",
   "label": "Enable WIP Ledger",
   "fieldtype": "Check",
   "default": "1"
  },
  {
   "fieldname": "enable_dynamic_forms",
   "label": "Enable Dynamic Forms",
   "fieldtype": "Check",
   "default": "1"
  },
  {
   "fieldname": "operator_session_timeout_minutes",
   "label": "Operator Session Inactivity (Minutes)",
   "fieldtype": "Int",
   "default": "15",
   "reqd": 1
  },
  {
   "fieldname": "enable_administrator_operator_bypass",
   "label": "Enable Administrator Operator Bypass (Development Only)",
   "fieldtype": "Check",
   "default": "0",
   "description": "Allows only the Administrator account to act as a selected Employee in the Operator Console. Disable before production use."
  },
  {
   "fieldname": "command_retry_limit",
   "label": "Command Retry Limit",
   "fieldtype": "Int",
   "default": "3"
  },
  {
   "fieldname": "exception_email_role",
   "label": "Exception Email Role",
   "fieldtype": "Link",
   "options": "Role"
  }
 ]
}
