{
 "doctype":"DocType",
 "name":"CFG Kanban Dispatch Profile",
 "module":"CFG Kanban",
 "autoname":"field:profile_name",
 "title_field":"business_label",
 "search_fields":"profile_name,business_label,company,source_warehouse,plan_type,fulfilment_mode",
 "track_changes":1,
 "field_order":["identity_section","profile_name","business_label","active","display_colour","priority","instructions","dispatch_context_section","dispatch_point","company","source_warehouse","plan_type","fulfilment_mode","scope_section","customer_site","territory","logistics_route","destination_assignment_policy","destination_warehouse","staging_warehouse","transit_warehouse","policy_section","tag_policy","stock_rotation_policy","approval_required","allow_supervisor_override","auto_submit_stock_transfer","auto_submit_delivery_note","proof_policy","dispatch_responsibility","revision","notes"],
 "fields":[
  {"fieldname":"identity_section","label":"Operator-facing Dispatch Workflow","fieldtype":"Section Break","description":"E1 policy only. A Dispatch Profile identifies and explains the intended workflow; it does not reserve or move stock."},
  {"fieldname":"profile_name","label":"Profile Code","fieldtype":"Data","reqd":1,"unique":1,"in_list_view":1,"in_standard_filter":1,"description":"Stable manager-controlled code, for example DSP-FZD-OPEN-ROUTE."},
  {"fieldname":"business_label","label":"Operator Label","fieldtype":"Data","reqd":1,"in_list_view":1,"description":"Plain-language work choice shown in the Logistics panel."},
  {"fieldname":"active","label":"Active","fieldtype":"Check","default":"1","in_list_view":1,"in_standard_filter":1},
  {"fieldname":"display_colour","label":"Display Colour","fieldtype":"Select","options":"Blue\nGreen\nOrange\nRed\nPurple\nGrey","default":"Blue","reqd":1},
  {"fieldname":"priority","label":"Launcher Priority","fieldtype":"Int","default":"100","reqd":1,"in_list_view":1,"description":"Lower numbers appear first at the Dispatch Point."},
  {"fieldname":"instructions","label":"Operator Instructions","fieldtype":"Small Text","reqd":1,"description":"Short instruction explaining when the operator should choose this workflow."},
  {"fieldname":"dispatch_context_section","label":"Dispatch Point and Company","fieldtype":"Section Break"},
  {"fieldname":"dispatch_point","label":"Dispatch Operations Card","fieldtype":"Link","options":"CFG Kanban Card","reqd":1,"in_list_view":1,"in_standard_filter":1,"description":"Permanent Location Card whose Location Purpose is Dispatch Operations."},
  {"fieldname":"company","label":"Company","fieldtype":"Link","options":"Company","reqd":1,"in_list_view":1,"in_standard_filter":1},
  {"fieldname":"source_warehouse","label":"Source Warehouse","fieldtype":"Link","options":"Warehouse","reqd":1,"in_list_view":1,"in_standard_filter":1},
  {"fieldname":"plan_type","label":"Plan Type","fieldtype":"Select","options":"Customer Order\nOpen Route Stock","reqd":1,"in_list_view":1,"in_standard_filter":1},
  {"fieldname":"fulfilment_mode","label":"Fulfilment Mode","fieldtype":"Select","options":"Vehicle Delivery\nDirect Warehouse Delivery\nCustomer Pickup\nExisting Ad-hoc Lorry Delivery\nGoods in Transit","reqd":1,"in_list_view":1,"in_standard_filter":1},
  {"fieldname":"scope_section","label":"Eligible Business Scope","fieldtype":"Section Break","description":"Optional scope narrows where this workflow may later be used by Dispatch Plans."},
  {"fieldname":"customer_site","label":"Customer Site Scope","fieldtype":"Link","options":"CFG Kanban Customer Scan Point"},
  {"fieldname":"territory","label":"Territory Scope","fieldtype":"Link","options":"Territory"},
  {"fieldname":"logistics_route","label":"Logistics Route","fieldtype":"Link","options":"CFG Kanban Logistics Route"},
  {"fieldname":"destination_assignment_policy","label":"Destination Assignment","fieldtype":"Select","options":"Fixed\nSelect Before Dispatch\nSelect at Receipt","default":"Select Before Dispatch","reqd":1},
  {"fieldname":"destination_warehouse","label":"Fixed Destination Warehouse","fieldtype":"Link","options":"Warehouse","depends_on":"eval:doc.destination_assignment_policy=='Fixed'"},
  {"fieldname":"staging_warehouse","label":"Optional Staging Warehouse","fieldtype":"Link","options":"Warehouse"},
  {"fieldname":"transit_warehouse","label":"Goods-in-Transit Warehouse","fieldtype":"Link","options":"Warehouse","depends_on":"eval:doc.fulfilment_mode=='Goods in Transit'","mandatory_depends_on":"eval:doc.fulfilment_mode=='Goods in Transit'"},
  {"fieldname":"policy_section","label":"Operational Policy Snapshot","fieldtype":"Section Break"},
  {"fieldname":"tag_policy","label":"Physical Tag Policy","fieldtype":"Select","options":"Tagged\nUntagged\nMixed","default":"Mixed","reqd":1},
  {"fieldname":"stock_rotation_policy","label":"Stock Rotation Suggestion","fieldtype":"Select","options":"None\nFIFO\nFEFO","default":"FIFO","reqd":1},
  {"fieldname":"approval_required","label":"Supervisor Approval Required","fieldtype":"Check","default":"1"},
  {"fieldname":"allow_supervisor_override","label":"Allow Controlled Supervisor Override","fieldtype":"Check","default":"0"},
  {"fieldname":"auto_submit_stock_transfer","label":"Auto-submit Stock Transfer","fieldtype":"Check","default":"0"},
  {"fieldname":"auto_submit_delivery_note","label":"Auto-submit Delivery Note","fieldtype":"Check","default":"0"},
  {"fieldname":"proof_policy","label":"Delivery Proof Policy","fieldtype":"Select","options":"Inherit Customer Site\nRequired\nOptional\nUnattended Delivery Allowed\nNo Proof Required","default":"Inherit Customer Site","reqd":1},
  {"fieldname":"dispatch_responsibility","label":"Dispatch Responsibility","fieldtype":"Link","options":"CFG Kanban Responsibility","reqd":1,"in_standard_filter":1},
  {"fieldname":"revision","label":"Revision","fieldtype":"Int","default":"1","reqd":1,"read_only":1},
  {"fieldname":"notes","label":"Manager Notes","fieldtype":"Text"}
 ],
 "permissions":[
  {"role":"Stock Manager","read":1,"write":1,"create":1,"delete":1,"print":1},
  {"role":"Manufacturing Manager","read":1,"write":1,"create":1,"delete":1,"print":1},
  {"role":"System Manager","read":1,"write":1,"create":1,"delete":1,"print":1},
  {"role":"CFG Kanban System Maintenance","read":1,"write":1,"create":1,"delete":1,"print":1}
 ]
}
