  "follow_on_snapshot_json"
 ],
 "fields": [
  {
   "fieldname": "trip_details",
   "label": "Trip Details",
   "fieldtype": "Tab Break"
  },
  {
   "fieldname": "trip_title",
   "label": "Trip Title",
   "fieldtype": "Data"
  },
  {
   "fieldname": "state",
   "label": "Planning Status",
   "fieldtype": "Select",
   "read_only": 1,
   "options": "Draft\nPlanned\nClosed\nCancelled",
   "default": "Draft",
   "in_list_view": 1
  },
  {
   "fieldname": "company",
   "label": "Company",
   "fieldtype": "Link",
   "options": "Company",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "route_template",
   "label": "Standard Route / Template",
   "fieldtype": "Link",
   "options": "CFG Kanban Route Template",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "trip_date",
   "label": "Departure / Trip Date",
   "fieldtype": "Date",
   "reqd": 1,
   "default": "Today",
   "in_list_view": 1
  },
  {
   "fieldname": "expected_return_date",
   "label": "Expected Return Date",
   "fieldtype": "Date"
  },
  {
   "fieldname": "driver",
   "label": "Assigned Driver",
   "fieldtype": "Link",
   "options": "Employee"
  },
  {
   "fieldname": "driver_display",
   "label": "Assigned Driver \u2014 Name and ID",
   "fieldtype": "Data",
   "read_only": 1,
   "in_list_view": 1,
   "length": 300
  },
  {
   "fieldname": "vehicle_warehouse",
   "label": "Lorry Warehouse (Optional Until Assigned)",
   "fieldtype": "Link",
   "options": "Warehouse"
  },
  {
   "fieldname": "source_warehouse",
   "label": "Loading Source Warehouse (Optional)",
   "fieldtype": "Link",
   "options": "Warehouse"
  },
  {
   "fieldname": "region",
   "label": "Region",
   "fieldtype": "Data"
  },
  {
   "fieldname": "direction",
   "label": "Direction / Corridor",
   "fieldtype": "Data"
  },
  {
   "fieldname": "sequence_policy",
   "label": "Customer Stop Sequence",
   "fieldtype": "Select",
   "options": "Flexible Order\nPlanned Order",
   "default": "Flexible Order",
   "reqd": 1,
   "description": "Driver execution retains this sequence and the approved operational Route Sheet. Planned Order on either enforces the next stop."
  },
  {
   "fieldname": "planning_revision",
   "label": "Planning Revision",
   "fieldtype": "Int",
   "read_only": 1,
   "default": "1"
  },
  {
   "fieldname": "template_revision",
   "label": "Template Revision",
   "fieldtype": "Int",
   "read_only": 1
  },
  {
   "fieldname": "template_snapshot_json",
   "label": "Template Snapshot",
   "fieldtype": "Code",
   "read_only": 1,
   "options": "JSON",
   "hidden": 1
  },
  {
   "fieldname": "planning_help",
   "label": "Planning Instructions",
   "fieldtype": "HTML"
  },
  {
   "fieldname": "stops_tab",
   "label": "Customer Stops",
   "fieldtype": "Tab Break"
  },
  {
   "fieldname": "stops",
   "label": "Customer Stops",
   "fieldtype": "Table",
   "options": "CFG Kanban Delivery Trip Stop",
   "reqd": 1
  },
  {
   "fieldname": "inbox_tab",
   "label": "SO Route Inbox",
   "fieldtype": "Tab Break"
  },
  {
   "fieldname": "order_inbox",
   "label": "Sales Order Route Inbox",
   "fieldtype": "HTML"
  },
  {
   "fieldname": "orders_tab",
   "label": "Order Assignments",
   "fieldtype": "Tab Break"
  },
  {
   "fieldname": "orders",
   "label": "Trip Order Assignments",
   "fieldtype": "Table",
   "options": "CFG Kanban Delivery Trip Order",
   "description": "Use SO Route Inbox to assign or change the stop. Remove an assignment to release its planning quantity before dispatch execution starts."
  },
  {
   "fieldname": "plans_tab",
   "label": "Linked Dispatch Plans",
   "fieldtype": "Tab Break"
  },
  {
   "fieldname": "dispatch_plans",
   "label": "Existing Dispatch Plans",
   "fieldtype": "Table",
   "options": "CFG Kanban Delivery Trip Plan"
  },
  {
   "fieldname": "loading_tab",
   "label": "LIFO Loading Sequence",
   "fieldtype": "Tab Break"
  },
  {
   "fieldname": "loading_sequence",
   "label": "Saved Loading Instructions",
   "fieldtype": "Table",
   "options": "CFG Kanban Delivery Trip Load",
   "read_only": 1
  },
  {
   "fieldname": "loading_live",
   "label": "Current Dispatch Source Details",
   "fieldtype": "HTML"
  },
  {
   "fieldname": "notes_tab",
   "label": "Notes and History",
   "fieldtype": "Tab Break"
  },
  {
   "fieldname": "notes",
   "label": "Planning Notes",
   "fieldtype": "Small Text"
  },
  {
   "fieldname": "closure_reason",
   "label": "Closure / Cancellation Reason",
   "fieldtype": "Small Text"
  },
  {
   "fieldname": "closed_by",
   "label": "Closed / Cancelled By",
   "fieldtype": "Link",
   "read_only": 1,
   "options": "User"
  },
  {
   "fieldname": "closed_on",
   "label": "Closed / Cancelled On",
   "fieldtype": "Datetime",
   "read_only": 1
  },
  {
   "fieldname": "driver_execution_section",
   "label": "Driver Route Execution",
   "fieldtype": "Section Break",
   "read_only": 1
  },
  {
   "fieldname": "driver_route_state",
   "label": "Driver Route Status",
   "fieldtype": "Select",
   "read_only": 1,
   "options": "Not Started\nIn Progress\nCompleted\nClosed Incomplete",
   "default": "Not Started",
   "in_list_view": 1
  },
  {
   "fieldname": "driver_route_revision",
   "label": "Driver Action Revision",
   "fieldtype": "Int",
   "read_only": 1,
   "default": "0"
  },
  {
   "fieldname": "driver_route_started_on",
   "label": "Route Started On",
   "fieldtype": "Datetime",
   "read_only": 1
  },
  {
   "fieldname": "driver_route_started_by",
   "label": "Route Started By",
   "fieldtype": "Link",
   "read_only": 1,
   "options": "Employee"
  },
  {
   "fieldname": "driver_route_completed_on",
   "label": "Route Completed On",
   "fieldtype": "Datetime",
   "read_only": 1
  },
  {
   "fieldname": "driver_active_stop_key",
   "label": "Current Driver Stop",
   "fieldtype": "Data",
   "read_only": 1,
   "hidden": 1
  },
  {
   "fieldname": "driver_active_vehicle_key",
   "label": "Active Driver Lorry Key",
   "fieldtype": "Data",
   "read_only": 1,
   "unique": 1,
   "hidden": 1
  },
  {
   "fieldname": "driver_route_snapshot_json",
   "label": "Started Route Snapshot",
   "fieldtype": "Code",
   "read_only": 1,
   "options": "JSON",
   "hidden": 1
  },
  {
   "fieldname": "auto_generate_dispatch",
   "label": "Generate Dispatch on Mark Planned",
   "fieldtype": "Check",
   "default": "0",
   "description": "Creates preparation requests for assigned SO quantities. A shared Open Route Plan is created only for extra goods or explicitly enabled existing-lorry sales. No stock is reserved or posted."
  },
  {
   "fieldname": "dispatch_profile",
   "label": "Customer Order Dispatch Profile",
   "fieldtype": "Link",
   "options": "CFG Kanban Dispatch Profile"
  },
  {
   "fieldname": "open_route_profile",
   "label": "Shared Open Route Dispatch Profile",
   "fieldtype": "Link",
   "options": "CFG Kanban Dispatch Profile"
  },
  {
   "fieldname": "allow_existing_lorry_sales",
   "label": "Allow Sales from Existing Lorry Stock",
   "fieldtype": "Check",
   "default": "0",
   "description": "Enable optional sales at Visit Only Customer Sites using eligible stock already on the lorry. Creates a shared request subject to its Profile approval. Leave clear for information-only visits."
  },
  {
   "fieldname": "route_stock",
   "label": "Extra Goods for Shared Open Route",
   "fieldtype": "Table",
   "options": "CFG Kanban Trip Stock"
  },
  {
   "fieldname": "open_route_plan",
   "label": "Shared Open Route Plan",
   "fieldtype": "Link",
   "options": "CFG Kanban Dispatch Plan",
   "read_only": 1
  },
  {
   "fieldname": "dispatch_generated_on",
   "label": "Dispatch Generated On",
   "fieldtype": "Datetime",
   "read_only": 1
  },
  {
   "fieldname": "assistant_drivers",
   "label": "Assistant Drivers",
   "fieldtype": "Table",
   "options": "CFG Kanban Trip Assistant",
   "description": "Office presets before departure. Each assistant uses their own Kanban login and delivery permissions. During an active route the lead Assigned Driver can add assistants from Driver Route."
  },
  {
   "fieldname": "team_revision",
   "label": "Team Revision",
   "fieldtype": "Int",
   "default": "0",
   "read_only": 1
  },
  {
   "fieldname": "driver_stop_order_json",
   "label": "Runtime Delivery Order",
   "fieldtype": "Code",
   "options": "JSON",
   "read_only": 1,
   "hidden": 1
  },
  {
   "fieldname": "route_sequence_revision",
   "label": "Runtime Order Revision",
   "fieldtype": "Int",
   "default": "0",
   "read_only": 1
  },
  {
   "fieldname": "route_order_source",
   "label": "Runtime Order Source",
   "fieldtype": "Data",
   "read_only": 1
  },
  {
   "fieldname": "route_change_request",
   "label": "Latest Route Change Request",
   "fieldtype": "Link",
   "options": "CFG Kanban Route Change Request",
   "read_only": 1
  },
  {
   "fieldname": "gps_settings",
   "label": "Driver GPS",
   "fieldtype": "Section Break"
  },
  {
   "fieldname": "gps_publish_interval_seconds",
   "label": "GPS Publish Interval (seconds)",
   "fieldtype": "Select",
   "options": "15\n30\n60\n120\n300",
   "default": "15",
   "description": "Longer intervals request location less often. Applied at the next GPS publish or source refresh."
  },
  {
   "fieldname": "gps_auto_start",
   "label": "Auto-start GPS on Start Route",
   "fieldtype": "Check",
   "default": "0",
   "description": "Starts on the assigned driver or assistant device that confirms Start Route, after browser location permission. Stop GPS remains available."
  }
 ,
  {"fieldname":"follow_on_section","fieldtype":"Tab Break","label":"Follow-on Trip"},
  {"fieldname":"follow_on_of","fieldtype":"Link","options":"CFG Kanban Delivery Trip","label":"Continued From Trip","read_only":1},
  {"fieldname":"follow_on_trip","fieldtype":"Link","options":"CFG Kanban Delivery Trip","label":"Follow-on Trip","read_only":1},
  {"fieldname":"follow_on_setup","fieldtype":"HTML","label":"Follow-on Setup"},
  {"fieldname":"follow_on_key","fieldtype":"Data","label":"Follow-on Source Key","read_only":1,"hidden":1,"unique":1},
  {"fieldname":"follow_on_request_key","fieldtype":"Data","label":"Follow-on Request Key","read_only":1,"hidden":1,"unique":1},
  {"fieldname":"follow_on_snapshot_json","fieldtype":"Code","options":"JSON","label":"Confirmed Follow-on Receipt","read_only":1},
  {
   "fieldname": "consolidated_customer_orders",
   "label": "Consolidated Customer Orders",
   "fieldtype": "Check",
   "default": "0",
   "description": "Generate one Customer Order Dispatch Plan for this Trip. Exact customer stops and Sales Order rows retain their own allocations and Delivery Notes. Select before generating dispatch work."
  }
 ],
 "autoname": "KTRIP-.YYYY.-.#####",
 "title_field": "trip_title",
 "search_fields": "trip_title,route_template,company,driver,vehicle_warehouse",
 "sort_field": "modified",
 "sort_order": "DESC",
 "allow_rename": 0,
 "permissions": [
  {
   "role": "Stock User",
   "read": 1,
   "print": 1
  },
  {
   "role": "Stock Manager",
   "read": 1,
   "print": 1,
   "create": 1,
   "write": 1
  },
  {
   "role": "Sales User",
   "read": 1,
   "print": 1
  },
  {
   "role": "Sales Manager",
   "read": 1,
   "print": 1,
   "create": 1,
   "write": 1
  },
  {
   "role": "System Manager",
   "read": 1,
   "print": 1,
   "create": 1,
   "write": 1
  },
  {
   "role": "CFG Kanban System Maintenance",
   "read": 1,
   "print": 1,
   "create": 1,
   "write": 1
  }
 ],
 "quick_entry": 0
}
