{
 "doctype":"DocType","name":"CFG Kanban Task Schedule","module":"CFG Kanban","autoname":"KTS-.#####","title_field":"schedule_name","track_changes":1,
 "field_order":["schedule_name","active","company","task_name","task_category","trigger_type","service_point_enabled","service_point_code","overlap_policy","holiday_policy","holiday_list","interval_value","interval_unit","calendar_repeat_days","next_due_on","default_due_hours","priority","responsible_role","workstation","asset","location","checklist","task_field_definitions","require_supervisor_verification","instructions","last_generated_on"],
 "fields":[
  {"fieldname":"schedule_name","label":"Schedule Name","fieldtype":"Data","reqd":1,"unique":1,"in_list_view":1},
  {"fieldname":"active","label":"Active","fieldtype":"Check","default":"1","in_list_view":1,"in_standard_filter":1},
  {"fieldname":"company","label":"Company","fieldtype":"Link","options":"Company","reqd":1,"in_standard_filter":1},
  {"fieldname":"task_name","label":"Task Name","fieldtype":"Data","reqd":1,"in_list_view":1},
  {"fieldname":"task_category","label":"Category","fieldtype":"Select","options":"Housekeeping\nMachine Maintenance\nVehicle Maintenance\nInspection\nSafety\nEmergency\nEnvironmental\nOther","reqd":1,"in_list_view":1,"in_standard_filter":1},
  {"fieldname":"trigger_type","label":"Trigger Type","fieldtype":"Select","options":"Time Interval\nCalendar Schedule\nMeter / Usage\nManual Request\nCondition\nEmergency Event","reqd":1,"in_list_view":1,"in_standard_filter":1},
  {"fieldname":"service_point_enabled","label":"Permanent Service Point QR","fieldtype":"Check","default":"0","description":"Use one permanent QR at the location. Each scan resolves to the current open occurrence for this schedule."},
  {"fieldname":"service_point_code","label":"Service Point Code","fieldtype":"Data","read_only":1,"unique":1,"description":"Stable scanner payload generated from this schedule."},
  {"fieldname":"overlap_policy","label":"Recurring Task Overlap Policy","fieldtype":"Select","options":"Prevent While Open\nAllow Parallel Occurrences","default":"Prevent While Open","reqd":1,"description":"Prevent While Open keeps one actionable occurrence until it is completed. Allow Parallel creates each due occurrence independently."},
  {"fieldname":"holiday_policy","label":"Holiday Generation Policy","fieldtype":"Select","options":"Generate Normally\nSkip Listed Holidays","default":"Generate Normally","reqd":1,"description":"Skip Listed Holidays advances the recurrence without creating an occurrence on a listed holiday."},
  {"fieldname":"holiday_list","label":"Holiday List","fieldtype":"Link","options":"Holiday List","depends_on":"eval:doc.holiday_policy=='Skip Listed Holidays'","mandatory_depends_on":"eval:doc.holiday_policy=='Skip Listed Holidays'"},
  {"fieldname":"interval_value","label":"Interval Value","fieldtype":"Float","depends_on":"eval:doc.trigger_type=='Time Interval'"},
  {"fieldname":"interval_unit","label":"Interval Unit","fieldtype":"Select","options":"Hours\nDays\nWeeks\nMonths","default":"Days","depends_on":"eval:doc.trigger_type=='Time Interval'"},
  {"fieldname":"calendar_repeat_days","label":"Calendar Repeat (Days)","fieldtype":"Int","default":"1","depends_on":"eval:doc.trigger_type=='Calendar Schedule'","description":"Repeat from Next Due On by this many calendar days."},
  {"fieldname":"next_due_on","label":"Next Due On","fieldtype":"Datetime","in_list_view":1},
  {"fieldname":"default_due_hours","label":"Complete Within (Hours)","fieldtype":"Float","default":"24"},
  {"fieldname":"priority","label":"Default Priority","fieldtype":"Select","options":"Low\nNormal\nHigh\nUrgent","default":"Normal"},
  {"fieldname":"responsible_role","label":"Responsible Kanban Role","fieldtype":"Link","options":"CFG Kanban Responsibility","description":"Operational task responsibility. This is independent of ERPNext User roles and permissions."},
  {"fieldname":"workstation","label":"Workstation","fieldtype":"Link","options":"Workstation","in_standard_filter":1},
  {"fieldname":"asset","label":"Asset","fieldtype":"Link","options":"Asset","in_standard_filter":1},
  {"fieldname":"location","label":"Location","fieldtype":"Data","in_standard_filter":1},
  {"fieldname":"checklist","label":"Checklist","fieldtype":"Small Text","description":"One checklist item per line."},
  {"fieldname":"task_field_definitions","label":"Dynamic Form Fields","fieldtype":"Table","options":"CFG Kanban Field Definition","description":"Use Applies To = Standalone Task."},
  {"fieldname":"require_supervisor_verification","label":"Require Supervisor Verification","fieldtype":"Check"},
  {"fieldname":"instructions","label":"Instructions","fieldtype":"Text Editor"},
  {"fieldname":"last_generated_on","label":"Last Generated On","fieldtype":"Datetime","read_only":1}
 ],
 "permissions":[
  {"role":"Manufacturing Manager","read":1,"write":1,"create":1,"delete":1},
  {"role":"System Manager","read":1,"write":1,"create":1,"delete":1}
 ]
