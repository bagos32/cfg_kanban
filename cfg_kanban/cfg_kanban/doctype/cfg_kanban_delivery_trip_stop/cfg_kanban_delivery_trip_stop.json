{
 "doctype": "DocType",
 "name": "CFG Kanban Delivery Trip Stop",
 "module": "CFG Kanban",
 "engine": "InnoDB",
 "track_changes": 1,
 "field_order": [
  "stop_key",
  "template_row",
  "delivery_sequence",
  "stop_purpose",
  "customer_scan_point",
  "customer",
  "site_name",
  "customer_address",
  "address_display",
  "instructions",
  "driver_completed_on",
  "driver_completed_by",
  "driver_visit_notes",
  "cancellation_request",
  "stop_cancelled_on",
  "stop_cancelled_by",
  "stop_cancellation_reason",
 "planner_service_minutes",
 "planner_window_start",
 "planner_window_end",
 "planner_finish_by_close"
 ],
 "fields": [
  {
   "fieldname": "stop_key",
   "label": "Stop Identity",
   "fieldtype": "Data",
   "read_only": 1,
   "hidden": 1
  },
  {
   "fieldname": "template_row",
   "label": "Template Row",
   "fieldtype": "Data",
   "read_only": 1,
   "hidden": 1
  },
  {
   "fieldname": "delivery_sequence",
   "label": "Stop No.",
   "fieldtype": "Int",
   "read_only": 1,
   "in_list_view": 1,
   "columns": 1
  },
  {
   "fieldname": "stop_purpose",
   "label": "Purpose",
   "fieldtype": "Select",
   "options": "Delivery\nVisit Only",
   "default": "Delivery",
   "reqd": 1,
   "in_list_view": 1,
   "columns": 2
  },
  {
   "fieldname": "customer_scan_point",
   "label": "Customer Site",
   "fieldtype": "Link",
   "options": "CFG Kanban Customer Scan Point",
   "mandatory_depends_on": "eval:doc.stop_purpose=='Delivery'",
   "in_list_view": 1,
   "columns": 4
  },
  {
   "fieldname": "customer",
   "label": "Customer",
   "fieldtype": "Link",
   "options": "Customer",
   "reqd": 1,
   "in_list_view": 1,
   "read_only_depends_on": "eval:!!doc.customer_scan_point",
   "columns": 3
  },
  {
   "fieldname": "site_name",
   "label": "Stop Name",
   "fieldtype": "Data",
   "read_only": 1
  },
  {
   "fieldname": "customer_address",
   "label": "Customer Address",
   "fieldtype": "Link",
   "options": "Address",
   "read_only_depends_on": "eval:!!doc.customer_scan_point"
  },
  {
   "fieldname": "address_display",
   "label": "Address Details",
   "fieldtype": "Small Text",
   "read_only": 1
  },
  {
   "fieldname": "instructions",
   "label": "Stop / Visit Instructions",
   "fieldtype": "Small Text"
  },
  {
   "fieldname": "driver_completed_on",
   "label": "Driver Completed On",
   "fieldtype": "Datetime",
   "read_only": 1
  },
  {
   "fieldname": "driver_completed_by",
   "label": "Driver Completed By",
   "fieldtype": "Link",
   "read_only": 1,
   "options": "Employee"
  },
  {
   "fieldname": "driver_visit_notes",
   "label": "Driver Visit Notes",
   "fieldtype": "Small Text",
   "read_only": 1
  },
  {
   "fieldname": "cancellation_request",
   "label": "Cancellation Decision",
   "fieldtype": "Link",
   "read_only": 1,
   "options": "CFG Kanban Route Change Request"
  },
  {
   "fieldname": "stop_cancelled_on",
   "label": "Stop Cancelled On",
   "fieldtype": "Datetime",
   "read_only": 1
  },
  {
   "fieldname": "stop_cancelled_by",
   "label": "Stop Cancelled By",
   "fieldtype": "Link",
   "read_only": 1,
   "options": "Employee"
  },
  {
   "fieldname": "stop_cancellation_reason",
   "label": "Cancellation Reason",
   "fieldtype": "Small Text",
   "read_only": 1
  },
 {"fieldname":"planner_service_minutes","label":"Planner Service Minutes","fieldtype":"Float","precision":"2","description":"Required only for the mock pilot. Planned unloading duration."},
 {"fieldname":"planner_window_start","label":"Planner Receiving Opens (MYT)","fieldtype":"Time"},
 {"fieldname":"planner_window_end","label":"Planner Receiving Closes (MYT)","fieldtype":"Time"},
 {"fieldname":"planner_finish_by_close","label":"Finish Service Before Closing","fieldtype":"Check","default":"0"}
 ],
 "istable": 1
}
