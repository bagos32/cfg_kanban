 "content": "[{\"id\":\"attention_header\",\"type\":\"header\",\"data\":{\"text\":\"<span class=\\\"h4\\\"><b>Operational Attention</b></span><br><span class=\\\"text-muted\\\">Live exceptions, approvals, and work requiring supervisor action.</span>\",\"col\":12}},{\"id\":\"approval_count\",\"type\":\"number_card\",\"data\":{\"number_card_name\":\"Kanban Signals Awaiting Approval\",\"col\":3}},{\"id\":\"exception_count\",\"type\":\"number_card\",\"data\":{\"number_card_name\":\"Kanban Open Exceptions\",\"col\":3}},{\"id\":\"service_attention_count\",\"type\":\"number_card\",\"data\":{\"number_card_name\":\"Kanban Service Attention\",\"col\":3}},{\"id\":\"logistics_attention_count\",\"type\":\"number_card\",\"data\":{\"number_card_name\":\"Kanban Logistics Attention\",\"col\":3}},{\"id\":\"cycle_status_chart\",\"type\":\"chart\",\"data\":{\"chart_name\":\"Active Kanban Cycles by Status\",\"col\":12}},{\"id\":\"daily_header\",\"type\":\"header\",\"data\":{\"text\":\"<div style=\\\"padding-top:18px\\\"><span class=\\\"h4\\\"><b>Daily Operator Work</b></span><br><span class=\\\"text-muted\\\">Choose the panel that matches the physical work being performed.</span></div>\",\"col\":12}},{\"id\":\"operator_console\",\"type\":\"shortcut\",\"data\":{\"shortcut_name\":\"Production Operator Panel\",\"col\":3}},{\"id\":\"service_console\",\"type\":\"shortcut\",\"data\":{\"shortcut_name\":\"Service Task Panel\",\"col\":3}},{\"id\":\"logistics_console\",\"type\":\"shortcut\",\"data\":{\"shortcut_name\":\"Logistics Operator Panel\",\"col\":3}},{\"id\":\"manual\",\"type\":\"shortcut\",\"data\":{\"shortcut_name\":\"User Manual\",\"col\":3}},{\"id\":\"supervisor_header\",\"type\":\"header\",\"data\":{\"text\":\"<div style=\\\"padding-top:18px\\\"><span class=\\\"h4\\\"><b>Production Supervisor</b></span><br><span class=\\\"text-muted\\\">Approve signals, control sequence, and investigate production exceptions.</span></div>\",\"col\":12}},{\"id\":\"supervisor_action\",\"type\":\"shortc