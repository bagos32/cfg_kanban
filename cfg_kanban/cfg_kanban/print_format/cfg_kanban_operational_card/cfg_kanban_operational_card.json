{
 "align_labels_right":0,"custom_format":1,"disabled":0,"doc_type":"CFG Kanban Card","doctype":"Print Format","font":"Arial","html":"{% set ctx = get_card_print_context(doc.kanban_master) %}\n<div class=\"op-card\"><div class=\"op-band\">PRODUCTION KANBAN · OPERATIONAL CARD</div><div class=\"op-body\"><div><div class=\"label\">ITEM</div><div class=\"item\">{{ doc.item_code }}</div><div class=\"label\">CARD</div><div class=\"cardno\">{{ doc.card_number }}</div><div class=\"qty\">{{ doc.kanban_qty }} {{ ctx.stock_uom or '' }}</div></div><div class=\"code\"><img src=\"{{ get_qr_svg(doc.uuid or doc.qr_code, 170) }}\"><div>{{ doc.uuid or doc.qr_code }}</div></div></div><div class=\"move\"><div><span>IMMEDIATE SOURCE</span><b>{{ ctx.source_warehouse or '-' }}</b></div><div class=\"arrow\">→</div><div><span>IMMEDIATE DESTINATION</span><b>{{ ctx.destination_warehouse or '-' }}</b></div></div><div class=\"footer\"><span>Reusable</span><span>Rev {{ doc.revision }}</span><span>Print {{ doc.print_count or 0 }}</span><span>Scan and confirm before action</span></div></div>","margin_bottom":0,"margin_left":0,"margin_right":0,"margin_top":0,"module":"CFG Kanban","name":"CFG Kanban Operational Card","print_format_builder":0,"print_format_type":"Jinja","raw_printing":0,"show_section_headings":0,"standard":"Yes","css":"@page{size:A6 landscape;margin:5mm}body{font-family:Arial,sans-serif;color:#000}.op-card{height:95mm;border:1.5mm solid #000;padding:4mm;box-sizing:border-box;position:relative;overflow:hidden}.op-band{background:#000;color:#fff;font-size:16px;font-weight:800;padding:2mm 3mm}.op-body{display:grid;grid-template-columns:1fr 43mm;gap:5mm;margin-top:4mm}.label{font-size:9px;font-weight:700}.item{font-size:24px;font-weight:800}.cardno{font-size:17px;font-weight:700}.qty{font-size:31px;font-weight:900;margin-top:2mm}.code{text-align:center;font-size:7px;word-break:break-all}.code img{width:38mm;height:38mm}.move{display:grid;grid-template-columns:1fr 15mm 1fr;align-items:center;text-align:center;border:1.2mm solid #000;margin-top:3mm;padding:3mm}.move span{display:block;font-size:9px;font-weight:700}.move b{display:block;font-size:15px}.arrow{font-size:27px;font-weight:900}.footer{position:absolute;bottom:2mm;left:4mm;right:4mm;display:flex;justify-content:space-between;font-size:8px;font-weight:700}","default_print_language":"en"}
